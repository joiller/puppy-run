PUPPYRUN_ENV=development
PUPPYRUN_API_HOST=0.0.0.0
PUPPYRUN_API_PORT=8000
PUPPYRUN_DATABASE_URL=postgresql+asyncpg://puppyrun:puppyrun@localhost:5432/puppyrun
PUPPYRUN_REDIS_URL=redis://localhost:6379/0
PUPPYRUN_CORS_ORIGINS=["http://localhost:5173"]
PUPPYRUN_GITHUB_TOKEN=
PUPPYRUN_GITHUB_API_BASE_URL=https://api.github.com

# Phase 3 provider and source settings.
# Keep credential values private; do not commit API keys.
PUPPYRUN_LLM_PROVIDER=deterministic
PUPPYRUN_OPENAI_MODEL=gpt-5.5
PUPPYRUN_OPENAI_API_KEY=
PUPPYRUN_OPENAI_BASE_URL=
PUPPYRUN_TAVILY_API_KEY=
PUPPYRUN_ENABLE_REDDIT=false
PUPPYRUN_TOOL_TIMEOUT_SECONDS=10
PUPPYRUN_TOOL_RETRY_COUNT=1
PUPPYRUN_PHASE3_MAX_RESULTS_PER_SOURCE=5

VITE_API_BASE_URL=http://localhost:8000
